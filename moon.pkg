import {
  "Juwan-Hwang/moonboost/kernel",
  "moonbitlang/core/math",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/float",
} for "test"

options(
  targets: {
    "lockstep_nodes_int64.mbt": [ "not", "js", "wasm", "wasm-gc" ],
    "lockstep_nodes_wasm.mbt": [ "wasm", "wasm-gc" ],
    "lockstep_target_wasm.mbt": [ "wasm" ],
    "lockstep_target_wasmgc.mbt": [ "wasm-gc" ],
    "lockstep_cmp_native.mbt": [ "native" ],
    "lockstep_cmp_branchfree.mbt": [ "js", "wasm", "wasm-gc" ],
    "lockstep_nodes_js.mbt": [ "js" ],
    "lgb_exp_native.mbt": [ "native" ],
    "lgb_exp_soft.mbt": [ "not", "native" ],
    "lockstep_buf.mbt": [ "not", "js" ],
    "lockstep_buf_js.mbt": [ "js" ],
    "xgboost_src.mbt": [ "not", "js" ],
    "xgboost_src_js.mbt": [ "js" ],
  },
)
