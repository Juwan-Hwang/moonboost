///|
fn check_exp_vectors(vectors : String) -> Unit raise {
  for line in vectors.split("\n") {
    let parts = line.split(" ").to_array()
    if parts.length() != 2 {
      continue
    }
    let x = @string.parse_uint64(parts[0], base=16).reinterpret_as_double()
    let want = @string.parse_uint64(parts[1], base=16)
    let y = soft_exp(x)
    let z = lgb_exp(x)
    if !x.is_nan() {
      assert_eq(z.reinterpret_as_uint64(), want)
    }
    if x.is_nan() {
      assert_true(y.is_nan())
    } else if y.reinterpret_as_uint64() != want {
      fail("exp(\{x}): got \{y.reinterpret_as_uint64()}, want \{want}")
    }
  }
}

///|
test "lgb_exp matches glibc exp 0" {
  check_exp_vectors(
